# Relative DB_PATH is relative to the working directory; absolute paths are recommended.
DB_PATH=../data/blood.sqlite
SETTINGS_FILE=config/settings.default.yaml
ENGINE_SETTINGS_FILE=config/kenya.yaml
CORS_ORIGINS=http://localhost:3000
DATA_DIR=data
# ENGINE_DB_PATH=data/blood.db
CLERK_PUBLISHABLE_KEY=
ORG_FACILITY_MAP={}
SMS_SENDERS={}
# Outbound-only contacts do not grant permission to issue SMS commands.
SMS_FACILITY_CONTACTS={}
SMS_WEBHOOK_SECRET=
# Outbound SMS is opt-in. Live and sandbox credentials never fall back to each other.
SMS_ENABLED=0
SMS_ENVIRONMENT=sandbox
AFRICASTALKING_USERNAME=
AFRICASTALKING_API_KEY=
AFRICASTALKING_SANDBOX_API_KEY=
AFRICASTALKING_SENDER_ID=
AFRICASTALKING_SANDBOX_SENDER_ID=
# Generate a separate random callback token of at least 32 characters.
AFRICASTALKING_CALLBACK_TOKEN=
AFRICASTALKING_INBOUND_NUMBERS=[]
# AUTH_DISABLED=1  # Explicit local demos only; never production.
APP_ENV=development
IDEMPOTENCY_RETENTION_DAYS=30
# RESULTS_DIR=/absolute/path/to/results
