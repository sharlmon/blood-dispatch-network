# Copy into private backend/.env; run all Flask commands from backend/.
# Set DATA_DIR to the starter CSV folder (absolute or relative to repo root).
DATA_DIR=data
ENGINE_DB_PATH=data/sms-demo-engine.sqlite
DB_PATH=../data/sms-demo-workflow.sqlite
SETTINGS_FILE=config/settings.sms-demo.yaml
AUTH_DISABLED=1
SMS_ENABLED=1
SMS_ENVIRONMENT=sandbox
AFRICASTALKING_SANDBOX_API_KEY=
# Replace 12345 with your sandbox shortcode in BOTH settings below.
AFRICASTALKING_SANDBOX_SENDER_ID=12345
AFRICASTALKING_INBOUND_NUMBERS=["12345"]
# Generate privately: openssl rand -hex 32
AFRICASTALKING_CALLBACK_TOKEN=
SMS_SENDERS={"+254700000001":{"user_id":"demo-lab","org_id":"demo-westlands","facility_id":"HSP-004"},"+254700000002":{"user_id":"demo-supplier","org_id":"demo-national","facility_id":"HSP-001"}}
SMS_FACILITY_CONTACTS={}
