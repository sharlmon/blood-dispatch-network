[Unit]
Description=Blood Dispatch outbound SMS worker
After=network-online.target
Wants=network-online.target

[Service]
User=blood
Group=blood
WorkingDirectory=/opt/blood-dispatch-network/backend
EnvironmentFile=/etc/blood-dispatch/backend.env
Environment=APP_ENV=production
ExecStart=/opt/blood-dispatch-network/backend/.venv/bin/python -m flask --app wsgi sms-worker --interval 10
Restart=on-failure
RestartSec=5
TimeoutStopSec=45
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/blood-dispatch

[Install]
WantedBy=multi-user.target
