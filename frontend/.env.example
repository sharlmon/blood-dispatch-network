# Flask API. Live data needs the API running with the engine data built: DATA_DIR set on the API
# and `python scripts/build_db.py` run once (see backend/engine/README.md). Set this to an empty
# value to run the screens on the built-in, fictional demo data instead (no API calls at all).
NUXT_PUBLIC_API_BASE=http://localhost:5001

# Sign-in, pick one:
#  - Clerk: set both keys here AND Clerk on the API (CLERK_PUBLISHABLE_KEY or CLERK_ISSUER). In
#    development Clerk can run "keyless" without these, but the API then cannot verify sessions.
#  - Local demo without Clerk: run the API with AUTH_DISABLED=1 and set DEMO_AUTH=1 here.
NUXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
NUXT_CLERK_SECRET_KEY=
# DEMO_AUTH=1
