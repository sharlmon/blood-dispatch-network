# Flask API's own database (requests and audit log) and settings file; relative paths resolve from backend/.
DB_PATH=../data/blood.sqlite
SETTINGS_FILE=config/settings.default.yaml
CORS_ORIGINS=http://localhost:3000
# Ranking engine: folder with the starter CSVs (relative paths resolve from the repo root).
DATA_DIR=data
# Ranking engine database (optional; defaults to $DATA_DIR/blood.db). Separate from the API's DB_PATH.
# ENGINE_DB_PATH=data/blood.db
# Engine settings file backend/config/<ENGINE_COUNTRY>.yaml (default kenya).
ENGINE_COUNTRY=kenya
# Load the engine data in the background at API startup so the first request doesn't wait (0 = off).
ENGINE_WARMUP=1
# Freeze "now" for the demo: the request time when a request gives none. ISO 8601; no offset = East Africa
# Time. Overrides demo_clock in the settings file; unset = the real time.
# The synthetic starter data ends 2026-10-31; this freezes the request time for demos. Leave it unset in any
# real deployment.
DEMO_CLOCK=2026-10-31T00:58:00
# DS2 results JSON served at /api/results and /api/prealerts (relative paths resolve from the repo root).
RESULTS_DIR=results

# Backend (Flask) Clerk verification. The public key is enough: the issuer is derived from it.
CLERK_PUBLISHABLE_KEY=
# CLERK_AUTHORIZED_PARTIES=http://localhost:3000   # defaults to CORS_ORIGINS
# AUTH_DISABLED=1                                  # local demos only, never in production
