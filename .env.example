DB_PATH=../data/blood.sqlite
SETTINGS_FILE=config/settings.default.yaml
CORS_ORIGINS=http://localhost:3000
# Ranking engine: folder with the starter CSVs (relative paths resolve from the repo root).
DATA_DIR=data
# Ranking engine database (optional; defaults to $DATA_DIR/blood.db). Separate from the API's DB_PATH.
# ENGINE_DB_PATH=data/blood.db

# Backend (Flask) Clerk verification. The public key is enough: the issuer is derived from it.
CLERK_PUBLISHABLE_KEY=
# CLERK_AUTHORIZED_PARTIES=http://localhost:3000   # defaults to CORS_ORIGINS
# AUTH_DISABLED=1                                  # local demos only, never in production
